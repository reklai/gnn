package pages

import (
	"gnn/internal/components"
	"gnn/internal/content"
)

templ Construction(site content.SiteContent) {
	@components.Layout(site, "Construction", "construction") {
		<section id="construction-services" class="page-section">
			@components.ConstructionCardGrid(site.ConstructionCards)
		</section>
		<section class="page-section">
			@components.ProcessSteps(site.ConstructionSteps)
		</section>
	}
}
