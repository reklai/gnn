package components

import "gnn/internal/content"

templ Layout(site content.SiteContent, title string, active string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · { site.CompanyName }</title>
			<meta
				name="description"
				content="GN&N Company website for space rental, cleaning, construction, and Bayside Bar."
			/>
			<meta name="theme-color" content="#17324f"/>
			<link rel="stylesheet" href={ templ.URL(StylesheetHref()) }/>
			<script src="https://unpkg.com/htmx.org@2.0.4" defer></script>
			<script src={ templ.URL(GalleryScriptHref()) } defer></script>
		</head>
		<body class={ "page page-" + active }>
			@Header(site, active)
			<main class="page-shell">
				<div class="container page-stack">
					{ children... }
				</div>
			</main>
			@GalleryModal()
			@Footer(site)
		</body>
	</html>
}

templ Header(site content.SiteContent, active string) {
	<header class="site-header">
		<div class="container header-row">
			<a class="brand-lockup" href="/">
				<span class="brand-name">{ site.CompanyName }</span>
				<span class="brand-tag">Rental, cleaning, construction, and Bayside Bar</span>
			</a>
			<nav class="desktop-nav" aria-label="Primary navigation">
				for _, item := range content.PrimaryNavItems() {
					<a class={ NavLinkClass(active, item.Key) } href={ templ.URL(item.Href) }>
						{ item.Label }
					</a>
				}
			</nav>
			<a class="header-cta" href={ templ.URL(PhoneHref(site.OfficePhone)) }>Call Office</a>
			<details class="mobile-nav">
				<summary>Menu</summary>
				<div class="mobile-nav-panel">
					for _, item := range content.PrimaryNavItems() {
						<a class={ NavLinkClass(active, item.Key) } href={ templ.URL(item.Href) }>
							{ item.Label }
						</a>
					}
					<a class="mobile-header-cta" href={ templ.URL(PhoneHref(site.OfficePhone)) }>Call Office</a>
				</div>
			</details>
		</div>
	</header>
}

templ Footer(site content.SiteContent) {
	<footer class="site-footer">
		<div class="container footer-row">
			<a class="contact-pill footer-contact-pill" href={ templ.URL(PhoneHref(site.OfficePhone)) }>
				<span>Office</span>
				<strong>{ site.OfficePhone }</strong>
				<small>{ site.OfficeHours }</small>
			</a>
			<a class="contact-pill contact-pill-bar footer-contact-pill" href={ templ.URL(PhoneHref(site.BarPhone)) }>
				<span>Bar</span>
				<strong>{ site.BarPhone }</strong>
				<small>{ site.BarHours }</small>
			</a>
			<div class="footer-note-pill">
				<span>Lunch Break</span>
				<strong>{ site.LunchWindow }</strong>
				<small>Response may become delayed during this time.</small>
			</div>
		</div>
	</footer>
}

templ GalleryModal() {
	<div class="gallery-modal" data-gallery-modal hidden="">
		<div class="gallery-modal-backdrop" data-gallery-close></div>
		<div class="gallery-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="gallery-modal-count">
			<button type="button" class="gallery-modal-close" data-gallery-close aria-label="Close photo gallery">
				Close
			</button>
			<div class="gallery-modal-stage">
				<button
					type="button"
					class="gallery-modal-nav"
					data-gallery-prev
					aria-label="Previous photo"
				>
					‹
				</button>
				<div class="gallery-modal-frame" data-gallery-frame></div>
				<button type="button" class="gallery-modal-nav" data-gallery-next aria-label="Next photo">
					›
				</button>
			</div>
			<div class="gallery-modal-meta">
				<p id="gallery-modal-count" class="gallery-modal-count" data-gallery-count></p>
				<p class="gallery-modal-caption" data-gallery-caption></p>
			</div>
		</div>
	</div>
}
