package components

import "gnn/internal/content"

templ Hero(eyebrow string, title string, copy string, actions []content.Action, panels []content.FeaturePanel) {
	<section class="hero panel">
		<div class="hero-copy">
			<p class="eyebrow">{ eyebrow }</p>
			<h1>{ title }</h1>
			<p class="hero-lead">{ copy }</p>
			if len(actions) > 0 {
				<div class="hero-actions">
					for i, action := range actions {
						<a class={ ActionClass(i == 0) } href={ templ.URL(action.Href) }>
							{ action.Label }
						</a>
					}
				</div>
			}
		</div>
		<div class="tile-grid tile-grid-hero">
			for _, panel := range panels {
				<article class="media-tile" data-tone={ panel.Tone }>
					<strong>{ panel.Title }</strong>
					<span>{ panel.Detail }</span>
				</article>
			}
		</div>
	</section>
}

templ StatsBand(stats []content.Stat) {
	if len(stats) > 0 {
		<section class="stat-band">
			for _, stat := range stats {
				<div class="stat-card">
					<strong>{ stat.Value }</strong>
					<span>{ stat.Label }</span>
				</div>
			}
		</section>
	}
}

templ SectionIntro(eyebrow string, title string, copy string) {
	<div class="section-intro">
		<p class="eyebrow">{ eyebrow }</p>
		<h2>{ title }</h2>
		<p>{ copy }</p>
	</div>
}

templ ServiceGrid(cards []content.ServiceCard) {
	<div class="card-grid service-grid">
		for _, card := range cards {
			@ServiceCard(card)
		}
	</div>
}

templ ServiceCard(card content.ServiceCard) {
	<article class="panel service-card" data-tone={ card.Tone }>
		<div class="service-card-top">
			<p class="eyebrow">{ card.Title }</p>
			<h3>{ card.Title }</h3>
		</div>
		<p>{ card.Summary }</p>
		<ul class="bullet-list">
			for _, highlight := range card.Highlights {
				<li>{ highlight }</li>
			}
		</ul>
		<a class="text-link" href={ templ.URL(card.Href) }>Open section</a>
	</article>
}

templ FeaturePanelGrid(panels []content.FeaturePanel) {
	<div class="tile-grid">
		for _, panel := range panels {
			<article class="media-tile" data-tone={ panel.Tone }>
				<strong>{ panel.Title }</strong>
				<span>{ panel.Detail }</span>
			</article>
		}
	</div>
}

templ RentalCatalogSection(activeFilter string, rentals []content.RentalOption) {
	<section id="rental-explorer" class="page-section rental-explorer">
		<div class="filter-row">
			for _, item := range content.RentalFilterItems() {
				<a
					class={ RentalFilterLinkClass(activeFilter, item.Key) }
					href={ templ.URL(RentalFilterHref(item.Key)) }
					hx-get={ RentalCatalogPartialHref(item.Key) }
					hx-target="#rental-explorer"
					hx-swap="outerHTML"
				>
					{ item.Label }
				</a>
			}
		</div>
		if len(rentals) == 0 {
			<div class="panel empty-state">
				<h3>No units match that filter</h3>
				<p>Try another unit type or use the inquiry form for more rental details.</p>
			</div>
		} else {
			<div class="card-grid rental-grid">
				for _, rental := range rentals {
					@RentalOptionCard(rental)
				}
			</div>
		}
	</section>
}

templ RentalOptionCard(rental content.RentalOption) {
	<article class="panel rental-card" data-tone={ rental.Tone }>
		<div class="rental-card-head">
			<div>
				<p class="eyebrow">{ rental.Title }</p>
				<h3>{ rental.Title }</h3>
			</div>
		</div>
		<p class="muted-copy">{ rental.Subtitle }</p>
		<div class="tile-grid tile-grid-compact">
			for _, galleryPanel := range rental.Gallery {
				<article class="media-tile media-tile-small" data-tone={ galleryPanel.Tone }>
					<strong>{ galleryPanel.Title }</strong>
					<span>{ galleryPanel.Detail }</span>
				</article>
			}
		</div>
		<ul class="bullet-list">
			for _, feature := range rental.Features {
				<li>{ feature }</li>
			}
		</ul>
		<div class="rental-meta">
			<p><strong>Rate:</strong> { rental.RateLabel }</p>
			<p><strong>Laundry:</strong> { rental.LaundryNote }</p>
		</div>
	</article>
}

templ ServiceCategoryGrid(categories []content.ServiceCategory) {
	<div class="card-grid service-group-grid">
		for _, category := range categories {
			@ServiceCategoryCard(category)
		}
	</div>
}

templ ServiceCategoryCard(category content.ServiceCategory) {
	<article class="panel service-group-card" data-tone={ category.Tone }>
		<p class="eyebrow">{ category.Title }</p>
		<h3>{ category.Title }</h3>
		<p>{ category.Summary }</p>
		<ul class="bullet-list">
			for _, point := range category.Points {
				<li>{ point }</li>
			}
		</ul>
	</article>
}

templ ConstructionCardGrid(cards []content.ConstructionCard) {
	<div class="card-grid construction-grid">
		for _, card := range cards {
			@ConstructionServiceCard(card)
		}
	</div>
}

templ ConstructionServiceCard(card content.ConstructionCard) {
	<article class="panel construction-card" data-tone={ card.Tone }>
		<p class="eyebrow">{ card.Title }</p>
		<h3>{ card.Title }</h3>
		<p>{ card.Summary }</p>
		<ul class="bullet-list">
			for _, point := range card.Points {
				<li>{ point }</li>
			}
		</ul>
	</article>
}

templ ProcessSteps(items []string) {
	<ol class="process-strip">
		for _, item := range items {
			<li class="panel process-card">{ item }</li>
		}
	</ol>
}

templ InquiryForm(config content.InquiryFormConfig) {
	<form
		class="panel inquiry-form"
		method="post"
		action={ templ.URL(InquiryAction()) }
		hx-post={ InquiryAction() }
		hx-target={ InquiryTargetSelector(config.TargetID) }
		hx-swap="innerHTML"
	>
		<div>
			<p class="eyebrow">{ config.Scope }</p>
			<h3>{ config.Title }</h3>
			<p>{ config.Intro }</p>
		</div>
		<input type="hidden" name="scope" value={ config.Scope }/>
		<label class="field">
			<span>Name</span>
			<input type="text" name="name" placeholder="Your name" required/>
		</label>
		<label class="field">
			<span>Phone</span>
			<input type="tel" name="phone" placeholder="680-000-0000" required/>
		</label>
		<label class="field">
			<span>Details</span>
			<textarea
				name="details"
				rows="5"
				placeholder="Tell GN&N what you need, the property type, or the unit you want to ask about."
			></textarea>
		</label>
		<button class="button" type="submit">{ config.SubmitLabel }</button>
		<div id={ config.TargetID } class="form-response"></div>
	</form>
}

templ InquiryStatus(title string, message string, isSuccess bool) {
	<div class={ InquiryStatusClass(isSuccess) }>
		<h3>{ title }</h3>
		<p>{ message }</p>
	</div>
}

templ SchedulePanel(nights []content.PerformanceNight) {
	<section id="bar-schedule" class="panel schedule-panel">
		<div class="schedule-head">
			<div>
				<p class="eyebrow">Live lineup</p>
				<h2>Thursday to Sunday, 10pm-2am</h2>
				<p>The singer list is fixed here, while keyboard support rotates between Maslyn and Brandon.</p>
			</div>
			<button
				class="button button-secondary button-inline"
				type="button"
				hx-get={ SchedulePartialHref() }
				hx-target="#bar-schedule"
				hx-swap="outerHTML"
			>
				Refresh schedule
			</button>
		</div>
		<div class="card-grid schedule-grid">
			for _, night := range nights {
				<article class="panel schedule-card" data-tone="night">
					<p class="eyebrow">{ night.Day }</p>
					<h3>{ CommaList(night.Singers) }</h3>
					<p><strong>Keyboard:</strong> { night.Keyboard }</p>
					<p>{ night.Note }</p>
				</article>
			}
		</div>
	</section>
}
