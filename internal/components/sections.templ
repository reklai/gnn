package components

import "gnn/internal/content"

templ SectionLead(eyebrow string, title string, summary string) {
	<div class="section-lead">
		if eyebrow != "" {
			<p class="eyebrow">{ eyebrow }</p>
		}
		<h2>{ title }</h2>
		if summary != "" {
			<p class="section-summary">{ summary }</p>
		}
	</div>
}

templ PageHero(site content.SiteContent, eyebrow string, title string, summary string, actionLabel string, actionHref string) {
	<section class="page-hero panel">
		<div class="page-hero-copy">
			<p class="eyebrow">{ eyebrow }</p>
			<h1>{ title }</h1>
			<p class="page-hero-summary">{ summary }</p>
			<div class="hero-actions">
				<a class="action-button action-button-primary" href={ templ.URL(actionHref) }>{ actionLabel }</a>
				<a class="action-button action-button-secondary" href={ templ.URL(PhoneHref(site.OfficePhone)) }>
					Office { site.OfficePhone }
				</a>
			</div>
		</div>
		<div class="page-hero-aside">
			<div class="hero-aside-card">
				<span>Office Hours</span>
				<strong>{ site.OfficeHours }</strong>
				<small>Lunch break { site.LunchWindow }</small>
			</div>
			<div class="hero-aside-card">
				<span>Bayside Bar</span>
				<strong>{ site.BarPhone }</strong>
				<small>{ site.BarHours }</small>
			</div>
		</div>
	</section>
}

templ ContactBand(site content.SiteContent, eyebrow string, title string, summary string, actionLabel string, actionHref string) {
	<section class="contact-band panel">
		<div class="contact-band-copy">
			<p class="eyebrow">{ eyebrow }</p>
			<h2>{ title }</h2>
			<p class="section-summary">{ summary }</p>
		</div>
		<div class="contact-band-actions">
			<a class="action-button action-button-primary" href={ templ.URL(actionHref) }>{ actionLabel }</a>
			<div class="contact-band-meta">
				<div>
					<span>Office</span>
					<strong>{ site.OfficePhone }</strong>
				</div>
				<div>
					<span>Bar</span>
					<strong>{ site.BarPhone }</strong>
				</div>
			</div>
		</div>
	</section>
}

templ RentalCatalogSection(activeFilter string, rentals []content.RentalOption) {
	<section id="rental-explorer" class="page-section rental-explorer">
		@SectionLead(
			"Rental Stock",
			"Available units by layout",
			"Filter studios, apartments, and houses. Rates and availability are confirmed through the office.",
		)
		<div class="filter-row">
			for _, item := range content.RentalFilterItems() {
				<a
					class={ RentalFilterLinkClass(activeFilter, item.Key) }
					href={ templ.URL(RentalFilterHref(item.Key)) }
					hx-get={ RentalCatalogPartialHref(item.Key) }
					hx-target="#rental-explorer"
					hx-swap="outerHTML"
				>
					{ item.Label }
				</a>
			}
		</div>
		if len(rentals) == 0 {
			<div class="panel empty-state">
				<h3>No units match that filter</h3>
				<p>Try another unit type or use the office number for more rental details.</p>
			</div>
		} else {
			<div class="card-grid rental-grid">
				for _, rental := range rentals {
					@RentalOptionCard(rental)
				}
			</div>
		}
	</section>
}

templ RentalOptionCard(rental content.RentalOption) {
	<article class="panel rental-card" data-tone={ rental.Tone }>
		<div class="rental-card-head">
			<div>
				<h3>{ rental.Title }</h3>
			</div>
		</div>
		@PictureStrip("rental-"+rental.Key, rental.Pictures)
		<ul class="bullet-list">
			for _, feature := range rental.Features {
				<li>{ feature }</li>
			}
		</ul>
		<div class="rental-meta">
			<p><strong>Rate:</strong> { rental.RateLabel }</p>
			<p><strong>Laundry:</strong> { rental.LaundryNote }</p>
		</div>
	</article>
}

templ ServiceCategoryGrid(categories []content.ServiceCategory) {
	<div class="card-grid service-group-grid">
		for _, category := range categories {
			@ServiceCategoryCard(category)
		}
	</div>
}

templ ServiceCategoryCard(category content.ServiceCategory) {
	<article class="panel service-group-card" data-tone={ category.Tone }>
		<h3>{ category.Title }</h3>
		@PictureStrip("cleaning-"+category.Title, category.Pictures)
		<ul class="bullet-list">
			for _, point := range category.Points {
				<li>{ point }</li>
			}
		</ul>
	</article>
}

templ ConstructionCardGrid(cards []content.ConstructionCard) {
	<div class="card-grid construction-grid">
		for _, card := range cards {
			@ConstructionServiceCard(card)
		}
	</div>
}

templ ConstructionServiceCard(card content.ConstructionCard) {
	<article class="panel construction-card" data-tone={ card.Tone }>
		<h3>{ card.Title }</h3>
		@PictureStrip("construction-"+card.Title, card.Pictures)
		<ul class="bullet-list">
			for _, point := range card.Points {
				<li>{ point }</li>
			}
		</ul>
	</article>
}

templ PictureStrip(group string, slots []content.PictureSlot) {
	if len(slots) > 0 {
		<div class="picture-strip">
			for index, slot := range slots {
				<button
					type="button"
					class="picture-slot"
					data-gallery-trigger
					data-gallery-group={ group }
					data-gallery-index={ index }
					data-gallery-src={ slot.EffectiveFullSrc() }
					data-gallery-alt={ slot.EffectiveAlt() }
					data-gallery-caption={ slot.DisplayLabel() }
					aria-label={ "Open photo " + slot.DisplayLabel() }
				>
					if slot.EffectiveThumbSrc() != "" {
						<img
							class="picture-media"
							src={ slot.EffectiveThumbSrc() }
							alt={ slot.EffectiveAlt() }
							loading="lazy"
							decoding="async"
						/>
					} else {
						<span>{ slot.DisplayLabel() }</span>
					}
				</button>
			}
		</div>
	}
}

templ ProcessSteps(items []string) {
	<ol class="process-strip">
		for _, item := range items {
			<li class="panel process-card">{ item }</li>
		}
	</ol>
}

templ SchedulePanel(nights []content.PerformanceNight) {
	<section id="bar-schedule" class="panel schedule-panel" data-tone="night">
		<div class="schedule-head">
			<div>
				<h2>Thursday to Sunday, 10pm-2am</h2>
			</div>
		</div>
		<div class="card-grid schedule-grid">
			for _, night := range nights {
				<article class="panel schedule-card" data-tone="night">
					<h4 class="eyebrow">{ night.Day }</h4>
					@PictureStrip("bar-"+night.Day, night.Pictures)
					<h5>
						<span class="schedule-label">Singers:</span>
						<strong class="schedule-value">{ CommaList(night.Singers) }</strong>
					</h5>
					<h5>
						<span class="schedule-label">Keyboard:</span>
						<strong class="schedule-value">{ night.Keyboard }</strong>
					</h5>
				</article>
			}
		</div>
	</section>
}
